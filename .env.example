# Contact / consultation form delivery (Resend)
# Copy this file to .env.local and fill in the values.

# From https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives form submissions.
# NOTE: while using the default onboarding@resend.dev sender below, Resend only
# delivers to the email address that owns your Resend account.
CONTACT_TO_EMAIL=

# Sender address. Leave as-is to start testing immediately. Once you verify your
# own domain in Resend, change this to e.g. "Zeenom <hello@yourdomain.com>" to
# send to any recipient and improve deliverability.
CONTACT_FROM_EMAIL="Zeenom <onboarding@resend.dev>"
